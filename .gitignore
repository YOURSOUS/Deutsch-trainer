# ===== 历史版本备份 =====
# 21 个 index_*.html 已移入此处，不随仓库发布。
# 注意：.gitignore 只挡 Git 提交，挡不住"手动拖拽上传"——
#       线上封锁由 netlify.toml 的 [[redirects]] 负责，两者缺一不可。
_archive/

# ===== 开发环境残留 =====
.idea/
.venv/
venv/
node_modules/
__pycache__/
*.pyc

# ===== 工作区协作记录 =====
.workbuddy/

# ===== 系统 / 编辑器 =====
.DS_Store
Thumbs.db
desktop.ini
*.log

# ===== 原始下载归档（严禁进 Git）=====
# OSD Modellsatz 原始 .zip 包共约 650MB，仅作本地归档，绝不进版本库/部署包。
# 已抽取的纯文本试题在 data/_raw/osd/ 下，正常纳入版本控制。
data/_sources/osd/**/*.zip

# ===== OSD 听力音频：只上线题目实际引用的 5 个（约 68MB）=====
# 6 个 ZDÖ 卷音频（B1_ZDO_*，约 106MB）属于战略放弃的卷，未被任何题目引用，
# 仅作本地归档，不进 Git / Netlify 部署包。
# 保留进仓库的 5 个：M8_H10_110124-komprimiert.mp3、ZB1 MS HV 1~4-converted.mp3。
data/audio/**/B1_ZDO_*.mp3

# ===== ÖSD A1 / A2 听力音频：只上线题目实际引用的 8 个（约 67MB）=====
# A1 引用 4 个（ZA1 / ZA1 Ö 各自的 Hören Aufgabe 1 + 3 音轨）；
# A2 引用 4 个（ZA2 / ZA2 Ö 各自的 Hören Aufgabe 1 + 3 音轨）。
# 未引用的 10 个（约 87MB）仅作本地归档，不进 Git / Netlify 部署包：
#   - KID_A1 / KID_A2 儿童版音轨（题型偏离主线，未纳入题库）
#   - 两套卷的 Hören Aufgabe 2 音轨（Notizblatt 开放式填空，无给定选项，未纳入题库）
# 注意：A1/A2 组装脚本的 audioUrls 已同步收敛为「仅引用音轨」，避免部署包内出现死链。
data/audio/a1/KID_A1_MS_A1.mp3
data/audio/a1/KID_A1_MS_A2.mp3
data/audio/a1/KID_A1_MS_A3.mp3
data/audio/a1/ZA1_MS_A2_060917.mp3
data/audio/a1/ZA1_OE_MS_A2_150917.mp3
data/audio/a2/KID_A2_MS_A1_120122.mp3
data/audio/a2/KID_A2_MS_A2_120122.mp3
data/audio/a2/KID_A2_MS_A3_120122.mp3
data/audio/a2/ZA2_MS_A2.mp3
data/audio/a2/ZA2_Oe_MS_A2_111017.mp3
# 兜底：将来新增的儿童版音轨一律不进仓库
data/audio/**/KID_*.mp3

# ===== ÖSD B2 听力音频：6 条全部上线（约 131.26MB）=====
# 3 套卷各含 Hören Aufgabe 1 / 2 两条音轨。
# v0.10 起 ZB2 / ZB2_J 的 Hören Aufgabe 2 打叉网格已按 A2 方案忠实展开为
# JA/NEIN 判断题（33 + 39 格），对应音轨重新被题目引用，故取消此前对
# ZB2_MS_A2_270917.mp3 / ZB2_J_MS_A2.mp3 的排除，避免线上听力组无声。
# （Hören 2 的开放式数值填空行仍不纳入题库，但卷面结构已写进 passage。）

# ===== ÖSD C1 听力音频：只上线题目实际引用的 2 个（约 113MB）=====
# 3 套卷各含 Hören Aufgabe 1 / 2 两条音轨，PMB 另有原始大文件与压缩版各一份，
# 共 8 个（280.96MB）。方案 B 按用户决策剔除 PMB 与 ZC1 逐字重复的
# Lesen/Hören Aufgabe 1 两组后，只剩 2 条音轨被题目引用（已分 2 次提交上线）：
#   ZC1_MS_A1_05122017.mp3、ZC1_J_MS_Aufgabe1.mp3。
# 其余 6 个全部排除，确保部署包零冗余：
#   - 3 套卷的 Hören Aufgabe 2 音轨：10 条开放式 NOTIZEN 补全（无打叉网格，
#     答案卡为单词/短语），按 A1/A2 既定口径不纳入题库，故无题目引用；
#   - ZC1/PMB 的原始未压缩音轨（55.29MB / 30.77MB），与 -converted 版内容重复；
#   - PMB 的 -converted 音轨：去重后已无任何题目引用。
data/audio/c1/ZC1_MS_A2_04122017.mp3
data/audio/c1/ZC1_J_MS_Aufgabe2.mp3
data/audio/c1/ZC1_PMB_MS_A2_100725-converted.mp3
data/audio/c1/ZC1_PMB_MS_A1_300625.mp3
data/audio/c1/ZC1_PMB_MS_A2_100725.mp3
data/audio/c1/ZC1_PMB_MS_A1_300625-converted.mp3

# ===== 本地中间产物与备份（严禁进仓库 / Netlify 部署包）=====
# OSD 收割流水线在 data/_staging/ 下产生的 parsed JSON、词库扫描中间文件
# （missing_words.json / new_words_entries.json / words_uncovered.json）、
# 渲染 PNG 与各类 .json.bak，只用于本地组装 questions.js / words.js。
# 合并完成后一律不进版本库；提交必须走精确清单，绝不 git add -A。
data/_staging/
# 原始下载归档（PDF / ZIP / 原始素材）与本地历史备份，同样不进部署包。
data/_sources/
*.bak
